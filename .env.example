# ===========================================
# Voice Memory System — Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_memory
POSTGRES_USER=voice_user
POSTGRES_PASSWORD=voice_pass_dev
DATABASE_URL=postgresql+asyncpg://voice_user:voice_pass_dev@localhost:5432/voice_memory

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memories

# --- Object Storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voice-notes
S3_REGION=us-east-1

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
